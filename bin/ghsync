#!/usr/bin/env bash
#
# ghsync — clone and keep all your GitHub repositories up to date.
#
#   ghsync                      launch the TUI
#   ghsync clone                clone every repo that is missing locally
#   ghsync pull                 fetch + fast-forward every local repo
#   ghsync commit REPO MESSAGE  stage changes and create a local commit
#   ghsync sync                 clone missing, then pull everything
#   ghsync status               show branch / dirty / ahead-behind for each repo
#   ghsync cron install "0 */6 * * *"
#   ghsync cron remove | status
#
# Requires: bash 4+, git, gh (GitHub CLI, authenticated with `gh auth login`).
#
set -uo pipefail

VERSION="26.4"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CRON_TAG="# ghsync"

# cron gives us a bare PATH — make sure git/gh are still findable.
export PATH="$PATH:/usr/local/bin:/usr/bin:/bin:/snap/bin:$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghsync"
CONFIG_FILE="$CONFIG_DIR/config"
THIRD_PARTY_FILE="$CONFIG_DIR/third-party.tsv"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ghsync"
LOG_FILE="$STATE_DIR/ghsync.log"
LOCK_FILE="$STATE_DIR/ghsync.lock"
mkdir -p "$CONFIG_DIR" "$STATE_DIR"

# ---------------------------------------------------------------- defaults ---
ROOT="$HOME/github"       # where repos live: $ROOT/<owner>/<repo>
OWNERS=""                 # empty = your own repos; else "me myorg otherorg"
PROTOCOL="ssh"            # ssh | https
INCLUDE_FORKS=false
INCLUDE_ARCHIVED=false
JOBS=4                    # parallel git operations
LIMIT=1000                # max repos fetched per owner
GIT_TIMEOUT=600           # seconds per git operation
HOST=""                   # GitHub Enterprise host, empty = github.com
CLONE_FILTER="blob:none"  # blob:none | tree:0 | depth:N | none
MIRROR=false              # bare mirrors instead of working trees
EXCLUDE=""                # glob patterns to skip, e.g. "acme/huge-* */fork-*"
NOTIFY=true               # send failures to the journal
QUIET=false
PORCELAIN=false           # tab-separated machine output (used by the Cockpit plugin)

# config file overrides defaults
# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && . "$CONFIG_FILE"

# environment overrides config (this is how parent -> worker state is passed)
ROOT="${GHSYNC_ROOT:-$ROOT}"
OWNERS="${GHSYNC_OWNERS:-$OWNERS}"
PROTOCOL="${GHSYNC_PROTOCOL:-$PROTOCOL}"
JOBS="${GHSYNC_JOBS:-$JOBS}"
QUIET="${GHSYNC_QUIET:-$QUIET}"
PORCELAIN="${GHSYNC_PORCELAIN:-$PORCELAIN}"
HOST="${GHSYNC_HOST:-$HOST}"
CLONE_FILTER="${GHSYNC_CLONE_FILTER:-$CLONE_FILTER}"
MIRROR="${GHSYNC_MIRROR:-$MIRROR}"
EXCLUDE="${GHSYNC_EXCLUDE:-$EXCLUDE}"
[[ -n "$HOST" ]] && export GH_HOST="$HOST"

save_config() {
    cat >"$CONFIG_FILE" <<EOF
# ghsync configuration — edit by hand or through the TUI
ROOT="$ROOT"
OWNERS="$OWNERS"
PROTOCOL="$PROTOCOL"
INCLUDE_FORKS=$INCLUDE_FORKS
INCLUDE_ARCHIVED=$INCLUDE_ARCHIVED
JOBS=$JOBS
LIMIT=$LIMIT
GIT_TIMEOUT=$GIT_TIMEOUT
HOST="$HOST"
CLONE_FILTER="$CLONE_FILTER"
MIRROR=$MIRROR
EXCLUDE="$EXCLUDE"
NOTIFY=$NOTIFY
EOF
}

# ------------------------------------------------------------------ output ---
if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
    C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else
    C_RESET=''; C_DIM=''; C_BOLD=''
    C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''
fi

ts() { date '+%Y-%m-%d %H:%M:%S'; }

# report TAG COLOR NAME [DETAIL...] -> stdout + logfile + tally
report() {
    local tag="$1" color="$2" name="$3"; shift 3
    local detail="${*:-}"
    printf '%s  %-11s %s%s\n' "$(ts)" "$tag" "$name" "${detail:+ — $detail}" >>"$LOG_FILE"
    [[ -n "${GHSYNC_RESULT:-}" ]] && printf '%s\n' "$tag" >>"$GHSYNC_RESULT"
    if [[ "$PORCELAIN" == true ]]; then
        printf '%s\t%s\t%s\n' "$tag" "$name" "$detail"
        return 0
    fi
    [[ "$QUIET" == true ]] && return 0
    printf '  %s%-11s%s %s%s\n' "$color" "$tag" "$C_RESET" "$name" "${detail:+ — $detail}"
}
info() {
    [[ "$QUIET" == true || "$PORCELAIN" == true ]] && return 0
    printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"
}
err()  { printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; printf '%s  ERROR       %s\n' "$(ts)" "$*" >>"$LOG_FILE"; }

rotate_log() {
    local max=$((5 * 1024 * 1024))
    [[ -f "$LOG_FILE" ]] || return 0
    local size; size=$(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)
    (( size > max )) && mv -f "$LOG_FILE" "$LOG_FILE.1"
    return 0
}

# ----------------------------------------------------------------- helpers ---
TIMEOUT_BIN="$(command -v timeout || true)"
run_git() {
    if [[ -n "$TIMEOUT_BIN" ]]; then "$TIMEOUT_BIN" "$GIT_TIMEOUT" git "$@"
    else git "$@"; fi
}

preflight() {
    local ok=0
    command -v git >/dev/null || { err "git is not installed."; ok=1; }
    command -v gh  >/dev/null || { err "GitHub CLI (gh) is not installed — see https://cli.github.com"; ok=1; }
    (( ok )) && return 1
    if ! gh auth status >/dev/null 2>&1; then
        err "gh is not authenticated. Run: gh auth login"
        return 1
    fi
    return 0
}

acquire_lock() {
    command -v flock >/dev/null || return 0
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        err "another ghsync run is already in progress — skipping."
        return 1
    fi
    return 0
}

# List GitHub repos as: <owner/repo>\t<clone-url>
list_repos() {
    local filter='.[]'
    [[ "$INCLUDE_FORKS"    == true ]] || filter+=' | select(.isFork | not)'
    [[ "$INCLUDE_ARCHIVED" == true ]] || filter+=' | select(.isArchived | not)'
    if [[ "$PROTOCOL" == "https" ]]; then
        filter+=' | [.nameWithOwner, (.url + ".git")] | @tsv'
    else
        filter+=' | [.nameWithOwner, .sshUrl] | @tsv'
    fi
    local fields="nameWithOwner,isFork,isArchived,sshUrl,url"
    if [[ -z "$OWNERS" ]]; then
        gh repo list --limit "$LIMIT" --json "$fields" --jq "$filter" | filter_excluded
    else
        local owner
        for owner in $OWNERS; do
            gh repo list "$owner" --limit "$LIMIT" --json "$fields" --jq "$filter"
        done | filter_excluded
    fi
}

# Third-party registry rows as: <owner/repo>\t<clone-url>.
third_party_repos() {
    [[ -f "$THIRD_PARTY_FILE" ]] || return 0
    awk -F '\t' 'NF >= 2 && $1 != "" && $2 != "" { print $1 "\t" $2 }' "$THIRD_PARTY_FILE" | filter_excluded
}

# Every repository managed by ghsync. GitHub wins if a registry row reuses a name.
managed_repos() {
    local github
    github=$(list_repos) || return 1
    {
        [[ -n "$github" ]] && printf '%s\n' "$github"
        third_party_repos
    } | awk -F '\t' '$1 != "" && !seen[$1]++'
}

# Local clones as: <owner/repo>. Covers working trees and bare mirrors.
local_repos() {
    [[ -d "$ROOT" ]] || return 0
    {
        find "$ROOT" -mindepth 2 -maxdepth 3 -name .git -printf '%h\n' 2>/dev/null
        find "$ROOT" -mindepth 2 -maxdepth 2 -type d -name '*.git' -printf '%p\n' 2>/dev/null |
            sed 's|\.git$||'
    } | sed "s|^$ROOT/||" | sort -u | filter_excluded
}

# Where a repository lives, working tree or mirror.
repo_path() {
    if [[ -e "$ROOT/$1/.git" ]]; then printf '%s\n' "$ROOT/$1"
    elif [[ -d "$ROOT/$1.git" ]]; then printf '%s\n' "$ROOT/$1.git"
    fi
}

is_bare() { [[ "$(git -C "$1" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; }

# Drop lines whose first field matches an EXCLUDE pattern.
filter_excluded() {
    local line name pat keep
    if [[ -z "$EXCLUDE" ]]; then cat; return 0; fi
    while IFS= read -r line; do
        name="${line%%$'\t'*}"
        keep=true
        for pat in $EXCLUDE; do
            # shellcheck disable=SC2053  # deliberate glob match, not a literal
            if [[ "$name" == $pat ]]; then keep=false; break; fi
        done
        [[ "$keep" == true ]] && printf '%s\n' "$line"
    done
    return 0
}

# Count work that exists only on this machine: stashes and unpushed branches.
local_only_work() {
    local d="$1" stashes=0 unpushed=0 br up track
    stashes=$(git -C "$d" stash list 2>/dev/null | wc -l)
    while read -r br up track; do
        [[ -z "$br" ]] && continue
        if [[ -z "$up" ]]; then
            unpushed=$((unpushed + 1))
        elif [[ "$track" == *ahead* ]]; then
            unpushed=$((unpushed + 1))
        fi
    done < <(git -C "$d" for-each-ref --format='%(refname:short) %(upstream:short) %(upstream:track)' \
                 refs/heads 2>/dev/null)
    printf '%s %s\n' "$stashes" "$unpushed"
}

notify() {
    [[ "$NOTIFY" == true ]] || return 0
    if command -v systemd-cat >/dev/null; then
        printf '%s\n' "$*" | systemd-cat -t ghsync -p err
    elif command -v logger >/dev/null; then
        logger -t ghsync -p user.err -- "$*"
    fi
    return 0
}

# ----------------------------------------------------------- git operations ---
do_clone() {
    local name="$1" url="$2" dest out
    local -a args=()
    if [[ "$MIRROR" == true ]]; then
        dest="$ROOT/$name.git"
        args=(--mirror --quiet)
    else
        dest="$ROOT/$name"
        args=(--recurse-submodules --quiet)
        case "$CLONE_FILTER" in
            blob:none|tree:0) args+=(--filter="$CLONE_FILTER") ;;
            depth:*)          args+=(--depth "${CLONE_FILTER#depth:}" --no-single-branch) ;;
            *)                : ;;
        esac
    fi
    if [[ -n "$(repo_path "$name")" ]]; then
        report "exists" "$C_DIM" "$name"; return 0
    fi
    mkdir -p "$(dirname "$dest")"
    if out=$(run_git clone "${args[@]}" "$url" "$dest" 2>&1); then
        report "cloned" "$C_GREEN" "$name"
    else
        report "failed" "$C_RED" "$name" "${out##*$'\n'}"
        [[ -n "${GHSYNC_FAILED:-}" ]] && printf 'clone\t%s\t%s\n' "$name" "$url" >>"$GHSYNC_FAILED"
        return 1
    fi
}

do_pull() {
    local name="$1" d out branch upstream before after n counts stashes unpushed
    d=$(repo_path "$name")
    [[ -n "$d" ]] || { report "skipped" "$C_DIM" "$name" "not a git repo"; return 0; }

    if is_bare "$d"; then
        if out=$(run_git -C "$d" remote update --prune 2>&1); then
            report "updated" "$C_GREEN" "$name" "mirror refreshed"
        else
            report "failed" "$C_RED" "$name" "${out##*$'\n'}"
            [[ -n "${GHSYNC_FAILED:-}" ]] && printf 'pull\t%s\t\n' "$name" >>"$GHSYNC_FAILED"
            return 1
        fi
        return 0
    fi

    if ! out=$(run_git -C "$d" fetch --all --prune --tags --quiet 2>&1); then
        report "failed" "$C_RED" "$name" "fetch: ${out##*$'\n'}"
        [[ -n "${GHSYNC_FAILED:-}" ]] && printf 'pull\t%s\t\n' "$name" >>"$GHSYNC_FAILED"
        return 1
    fi

    counts=$(local_only_work "$d")
    stashes=${counts%% *}
    unpushed=${counts##* }
    if [[ -n "${GHSYNC_UNPUSHED:-}" ]] && (( stashes > 0 || unpushed > 0 )); then
        printf '%s\t%s\t%s\n' "$name" "$stashes" "$unpushed" >>"$GHSYNC_UNPUSHED"
    fi

    if [[ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]]; then
        report "dirty" "$C_YELLOW" "$name" "fetched, local changes left untouched"
        return 0
    fi
    if ! branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null); then
        report "detached" "$C_YELLOW" "$name" "not on a branch"
        return 0
    fi
    if ! upstream=$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
        report "no-upstream" "$C_YELLOW" "$name" "$branch has no tracking branch"
        return 0
    fi
    before=$(git -C "$d" rev-parse HEAD)
    if out=$(run_git -C "$d" merge --ff-only --quiet "$upstream" 2>&1); then
        after=$(git -C "$d" rev-parse HEAD)
        if [[ "$before" == "$after" ]]; then
            report "up-to-date" "$C_DIM" "$name" "$branch"
        else
            n=$(git -C "$d" rev-list --count "$before..$after")
            [[ -f "$d/.gitmodules" ]] && run_git -C "$d" submodule update --init --recursive --quiet >/dev/null 2>&1
            report "updated" "$C_GREEN" "$name" "$branch, +$n commits"
        fi
    else
        report "diverged" "$C_YELLOW" "$name" "$branch needs a manual merge or rebase"
    fi
}

do_commit() {
    local name="$1" message="$2" d out branch sha
    d=$(repo_path "$name")
    [[ -n "$d" ]] || { report "skipped" "$C_DIM" "$name" "not a git repo"; return 1; }

    if is_bare "$d"; then
        report "skipped" "$C_DIM" "$name" "bare mirror has no working tree"
        return 1
    fi
    if ! branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null); then
        report "detached" "$C_YELLOW" "$name" "switch to a branch before committing"
        return 1
    fi
    if [[ -z "$(git -C "$d" status --porcelain 2>/dev/null)" ]]; then
        report "clean" "$C_DIM" "$name" "nothing to commit"
        return 0
    fi
    if [[ -z "$message" ]]; then
        report "failed" "$C_RED" "$name" "commit message is required"
        return 1
    fi

    if ! out=$(run_git -C "$d" add -A 2>&1); then
        report "failed" "$C_RED" "$name" "git add: ${out##*$'\n'}"
        return 1
    fi
    if out=$(run_git -C "$d" commit -m "$message" 2>&1); then
        sha=$(git -C "$d" rev-parse --short HEAD 2>/dev/null || echo "?")
        report "committed" "$C_GREEN" "$name" "$branch $sha"
    else
        report "failed" "$C_RED" "$name" "git commit: ${out##*$'\n'}"
        return 1
    fi
}

do_status() {
    local name="$1" d branch dirty ahead behind counts stashes unpushed work
    d=$(repo_path "$name")
    [[ -n "$d" ]] || return 0

    if is_bare "$d"; then
        branch="mirror"; dirty=0; ahead=0; behind=0; stashes=0; unpushed=0
    else
        branch=$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached")
        dirty=$(git -C "$d" status --porcelain 2>/dev/null | wc -l)
        ahead=0; behind=0
        if counts=$(git -C "$d" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null); then
            ahead=${counts%%[[:space:]]*}; behind=${counts##*[[:space:]]}
        fi
        work=$(local_only_work "$d")
        stashes=${work%% *}
        unpushed=${work##* }
    fi

    if [[ "$PORCELAIN" == true ]]; then
        printf 'repo\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$name" "$branch" "$dirty" "$ahead" "$behind" "$stashes" "$unpushed"
        [[ -n "${GHSYNC_RESULT:-}" ]] && printf 'repo\n' >>"$GHSYNC_RESULT"
        return 0
    fi
    if (( dirty > 0 || ahead > 0 || stashes > 0 || unpushed > 0 )); then
        report "attention" "$C_YELLOW" "$(printf '%-40s %-14s %s dirty, %s ahead, %s behind, %s stashed, %s unpushed' \
            "$name" "$branch" "$dirty" "$ahead" "$behind" "$stashes" "$unpushed")"
    else
        report "clean" "$C_DIM" "$(printf '%-40s %-14s %s behind' "$name" "$branch" "$behind")"
    fi
}

do_stats() {
    local name="$1" d commits branches tags last author when size
    d=$(repo_path "$name")
    [[ -n "$d" ]] || return 0
    commits=$(git -C "$d" rev-list --count HEAD 2>/dev/null || echo 0)
    branches=$(git -C "$d" for-each-ref --format='%(refname)' refs/heads 2>/dev/null | wc -l)
    tags=$(git -C "$d" for-each-ref --format='%(refname)' refs/tags 2>/dev/null | wc -l)
    last=$(git -C "$d" log -1 --format=%ct 2>/dev/null || echo 0)
    author=$(git -C "$d" log -1 --format=%an 2>/dev/null || echo "")
    size=$(du -sk "$d" 2>/dev/null | cut -f1)
    [[ "$size" =~ ^[0-9]+$ ]] || size=0
    if [[ "$PORCELAIN" == true ]]; then
        # stat name commits branches tags epoch author size-in-kb
        printf 'stat\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$name" "$commits" "$branches" "$tags" "$last" "$author" "$size"
        [[ -n "${GHSYNC_RESULT:-}" ]] && printf 'stat\n' >>"$GHSYNC_RESULT"
        return 0
    fi
    if [[ "$last" -gt 0 ]]; then
        when=$(date -d "@$last" '+%Y-%m-%d' 2>/dev/null || echo "?")
    else
        when="never"
    fi
    report "stat" "$C_DIM" "$(printf '%-40s %7s commits %3s branches %3s tags %8s MiB  %s' \
        "$name" "$commits" "$branches" "$tags" "$((size / 1024))" "$when")"
}

# ------------------------------------------------------------ parallel runs ---
start_run() {
    RESULT_FILE=$(mktemp "$STATE_DIR/run.XXXXXX")
    UNPUSHED_FILE=$(mktemp "$STATE_DIR/unpushed.XXXXXX")
    FAILED_FILE="$STATE_DIR/failed.tsv"
    : >"$FAILED_FILE"
    export GHSYNC_RESULT="$RESULT_FILE" GHSYNC_UNPUSHED="$UNPUSHED_FILE" GHSYNC_FAILED="$FAILED_FILE"
    export GHSYNC_ROOT="$ROOT" GHSYNC_OWNERS="$OWNERS" GHSYNC_PROTOCOL="$PROTOCOL"
    export GHSYNC_JOBS="$JOBS" GHSYNC_QUIET="$QUIET" GHSYNC_PORCELAIN="$PORCELAIN"
    export GHSYNC_HOST="$HOST" GHSYNC_CLONE_FILTER="$CLONE_FILTER" GHSYNC_MIRROR="$MIRROR"
    export GHSYNC_EXCLUDE="$EXCLUDE"
    if [[ "$QUIET" == true ]]; then
        # never hang waiting for a password when running from cron
        export GIT_TERMINAL_PROMPT=0
        export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"
    fi
}

finish_run() {
    local total tag count
    if [[ -s "$RESULT_FILE" ]]; then
        total=$(wc -l <"$RESULT_FILE")
        printf '%s  summary     %s repos\n' "$(ts)" "$total" >>"$LOG_FILE"
        if [[ "$PORCELAIN" == true ]]; then
            printf 'summary\t%s\t\n' "$total"
        elif [[ "$QUIET" != true ]]; then
            printf '\n  %sSummary%s (%s repos)\n' "$C_BOLD" "$C_RESET" "$total"
            sort "$RESULT_FILE" | uniq -c | sort -rn | while read -r count tag; do
                printf '    %5d  %s\n' "$count" "$tag"
            done
        fi
    else
        info "  Nothing to do."
    fi
    warn_unpushed
    warn_failures
    rm -f "$RESULT_FILE" "$UNPUSHED_FILE"
    unset GHSYNC_RESULT GHSYNC_UNPUSHED GHSYNC_FAILED
}

# Work that exists only on this machine is the one thing a sync cannot fix.
warn_unpushed() {
    [[ -s "${UNPUSHED_FILE:-/dev/null}" ]] || return 0
    local n name stashes unpushed detail
    n=$(wc -l <"$UNPUSHED_FILE")
    while IFS=$'\t' read -r name stashes unpushed; do
        detail=""
        (( unpushed > 0 )) && detail="$unpushed unpushed branch(es)"
        (( stashes > 0 )) && detail="${detail:+$detail, }$stashes stash(es)"
        report "local-only" "$C_YELLOW" "$name" "$detail"
    done <"$UNPUSHED_FILE"
    printf '%s  local-only  %s repositories hold work that exists only here\n' "$(ts)" "$n" >>"$LOG_FILE"
    if [[ "$PORCELAIN" != true && "$QUIET" != true ]]; then
        local noun="repositories hold"; (( n == 1 )) && noun="repository holds"
        printf '\n  %s%s %s work that exists only on this machine.%s\n' \
            "$C_YELLOW" "$n" "$noun" "$C_RESET"
    fi
}

warn_failures() {
    [[ -s "${FAILED_FILE:-/dev/null}" ]] || return 0
    local n; n=$(wc -l <"$FAILED_FILE")
    notify "ghsync: $n repository operation(s) failed on $(hostname 2>/dev/null || echo host)"
    if [[ "$PORCELAIN" != true && "$QUIET" != true ]]; then
        printf '  %s%s operation(s) failed. Retry just those with: ghsync retry%s\n' \
            "$C_RED" "$n" "$C_RESET"
    fi
}

run_parallel() { # action; input lines on stdin
    xargs -r -P "$JOBS" -I '{}' "$SELF" _worker "$1" '{}'
}

# ---------------------------------------------------------------- actions ----
action_clone() {
    preflight || return 1
    acquire_lock || return 1
    rotate_log
    info "Listing managed repositories…"
    local list; list=$(managed_repos) || { err "could not list managed repositories"; return 1; }
    [[ -z "$list" ]] && { err "no managed repositories returned"; return 1; }
    info "$(wc -l <<<"$list") managed repositories found. Cloning missing ones into $ROOT"
    start_run
    printf '%s\n' "$list" | run_parallel clone
    finish_run
    local orphans
    orphans=$(comm -23 <(local_repos) <(printf '%s\n' "$list" | cut -f1 | sort -u) 2>/dev/null)
    if [[ -n "$orphans" ]]; then
        local n
        while IFS= read -r n; do
            [[ -n "$n" ]] && report "orphan" "$C_YELLOW" "$n" "not in the managed repository set"
        done <<<"$orphans"
    fi
}

action_pull() {
    acquire_lock || return 1
    rotate_log
    local list; list=$(local_repos)
    [[ -n "$FILTER" ]] && list=$(printf '%s\n' "$list" | grep -Fx "$FILTER")
    [[ -z "$list" ]] && { err "no matching local clones under $ROOT"; return 1; }
    info "Updating $(wc -l <<<"$list") local repositories in $ROOT"
    start_run
    printf '%s\n' "$list" | run_parallel pull
    finish_run
}

action_commit() {
    local name="$1" message="$2"
    acquire_lock || return 1
    rotate_log
    [[ -n "$name" ]] || { err "repository name is required"; return 1; }
    [[ -n "$message" ]] || { err "commit message is required"; return 1; }
    start_run
    do_commit "$name" "$message"
    local rc=$?
    finish_run
    return "$rc"
}

action_sync() {
    action_clone && action_pull
}

action_status() {
    local list; list=$(local_repos)
    [[ -n "$FILTER" ]] && list=$(printf '%s\n' "$list" | grep -Fx "$FILTER")
    [[ -z "$list" ]] && { err "no matching local clones under $ROOT"; return 1; }
    start_run
    printf '%s\n' "$list" | run_parallel status
    finish_run
}

# Re-run only what failed last time, instead of walking every repository again.
action_retry() {
    local failed="$STATE_DIR/failed.tsv"
    [[ -s "$failed" ]] || { info "Nothing to retry."; return 0; }
    acquire_lock || return 1
    local clones pulls
    clones=$(awk -F'\t' '$1 == "clone" { print $2 "\t" $3 }' "$failed")
    pulls=$(awk -F'\t' '$1 == "pull" { print $2 }' "$failed")
    info "Retrying $(wc -l <"$failed") failed operation(s)"
    start_run
    [[ -n "$clones" ]] && printf '%s\n' "$clones" | run_parallel clone
    [[ -n "$pulls" ]] && printf '%s\n' "$pulls" | run_parallel pull
    finish_run
}

# Local clones that are no longer in the GitHub or tracked third-party set.
action_orphans() {
    preflight || return 1
    local remote local_list orphans
    remote=$(managed_repos | cut -f1 | sort -u) || { err "could not list managed repositories"; return 1; }
    local_list=$(local_repos)
    [[ -z "$local_list" ]] && { info "No local clones."; return 0; }
    orphans=$(comm -23 <(printf '%s\n' "$local_list") <(printf '%s\n' "$remote"))
    if [[ -z "$orphans" ]]; then
        info "No orphaned clones."
        return 0
    fi
    local n
    while IFS= read -r n; do
        [[ -n "$n" ]] && report "orphan" "$C_YELLOW" "$n" "not in the managed repository set"
    done <<<"$orphans"
    if [[ "$PORCELAIN" != true && "$QUIET" != true ]]; then
        printf '\n  %sThese are not returned by GitHub and are not tracked as third-party repositories. Nothing was removed locally.%s\n' \
            "$C_DIM" "$C_RESET"
    fi
}

action_stats() {
    local list; list=$(local_repos)
    [[ -n "$FILTER" ]] && list=$(printf '%s\n' "$list" | grep -Fx "$FILTER")
    [[ -z "$list" ]] && { err "no matching local clones under $ROOT"; return 1; }
    start_run
    printf '%s\n' "$list" | run_parallel stats
    finish_run
}

# Machine-readable environment probe used by the Cockpit plugin.
action_check() {
    local git_v="" gh_v="" auth="no" user="" cron_line="" n_local=0
    command -v git >/dev/null && git_v=$(git --version 2>/dev/null | awk '{print $3}')
    command -v gh  >/dev/null && gh_v=$(gh --version 2>/dev/null | head -1 | awk '{print $3}')
    if [[ -n "$gh_v" ]] && gh auth status >/dev/null 2>&1; then
        auth="yes"; user=$(gh api user --jq .login 2>/dev/null || echo "")
    fi
    command -v crontab >/dev/null && cron_line=$(crontab -l 2>/dev/null | grep -F "$CRON_TAG")
    n_local=$(local_repos | grep -c . || true)
    printf 'check\tgit\t%s\n'    "$git_v"
    printf 'check\tgh\t%s\n'     "$gh_v"
    printf 'check\tauth\t%s\n'   "$auth"
    printf 'check\tuser\t%s\n'   "$user"
    printf 'check\troot\t%s\n'   "$ROOT"
    printf 'check\towners\t%s\n' "$OWNERS"
    printf 'check\tproto\t%s\n'  "$PROTOCOL"
    printf 'check\tjobs\t%s\n'   "$JOBS"
    printf 'check\tlimit\t%s\n'  "$LIMIT"
    printf 'check\tforks\t%s\n'  "$INCLUDE_FORKS"
    printf 'check\tarchived\t%s\n' "$INCLUDE_ARCHIVED"
    printf 'check\tlocal\t%s\n'  "$n_local"
    printf 'check\tcron\t%s\n'   "$cron_line"
    printf 'check\tlog\t%s\n'    "$LOG_FILE"
    printf 'check\tconfig\t%s\n' "$CONFIG_FILE"
    printf 'check\thost\t%s\n'   "$HOST"
    printf 'check\tfilter\t%s\n' "$CLONE_FILTER"
    printf 'check\tmirror\t%s\n' "$MIRROR"
    printf 'check\texclude\t%s\n' "$EXCLUDE"
    printf 'check\tnotify\t%s\n' "$NOTIFY"
    printf 'check\tfailed\t%s\n' "$(wc -l <"$STATE_DIR/failed.tsv" 2>/dev/null || echo 0)"
    local timer_when=""
    if command -v systemctl >/dev/null && [[ -f "$UNIT_DIR/ghsync.timer" ]] \
       && systemctl --user is-enabled ghsync.timer >/dev/null 2>&1; then
        timer_when=$(grep -oP '(?<=^OnCalendar=).*' "$UNIT_DIR/ghsync.timer" | head -1)
    fi
    printf 'check\ttimer\t%s\n' "$timer_when"
}

# ---------------------------------------------------------- systemd timer ----
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

timer_status() {
    local when=""
    if command -v systemctl >/dev/null && [[ -f "$UNIT_DIR/ghsync.timer" ]]; then
        when=$(grep -oP '(?<=^OnCalendar=).*' "$UNIT_DIR/ghsync.timer" 2>/dev/null | head -1)
        systemctl --user is-enabled ghsync.timer >/dev/null 2>&1 || when=""
    fi
    if [[ "$PORCELAIN" == true ]]; then
        printf 'timer\t%s\t\n' "$when"
        return 0
    fi
    if [[ -n "$when" ]]; then
        printf '  %sTimer active:%s %s\n' "$C_GREEN" "$C_RESET" "$when"
        systemctl --user list-timers --no-pager ghsync.timer 2>/dev/null | sed -n '2p'
    else
        printf '  %sNo systemd timer installed.%s\n' "$C_DIM" "$C_RESET"
    fi
}

timer_install() {
    local when="$1"
    command -v systemctl >/dev/null || { err "systemctl not found — use the cron job instead"; return 1; }
    mkdir -p "$UNIT_DIR"
    cat >"$UNIT_DIR/ghsync.service" <<EOF
[Unit]
Description=Sync GitHub repositories
Documentation=https://github.com/ghsync

[Service]
Type=oneshot
ExecStart=$SELF sync --quiet
EOF
    cat >"$UNIT_DIR/ghsync.timer" <<EOF
[Unit]
Description=Sync GitHub repositories on a schedule

[Timer]
OnCalendar=$when
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    if systemctl --user enable --now ghsync.timer >/dev/null 2>&1; then
        printf '  %sTimer installed:%s %s\n' "$C_GREEN" "$C_RESET" "$when"
        printf '  %sPersistent=true catches up a run missed while the machine was off.%s\n' "$C_DIM" "$C_RESET"
        if command -v loginctl >/dev/null && [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
            printf '  %sTo run while you are logged out: sudo loginctl enable-linger %s%s\n' \
                "$C_DIM" "$USER" "$C_RESET"
        fi
    else
        rm -f "$UNIT_DIR/ghsync.timer" "$UNIT_DIR/ghsync.service"
        err "could not enable ghsync.timer (is a user session bus available?)"
        return 1
    fi
}

timer_remove() {
    command -v systemctl >/dev/null || return 0
    systemctl --user disable --now ghsync.timer >/dev/null 2>&1
    rm -f "$UNIT_DIR/ghsync.timer" "$UNIT_DIR/ghsync.service"
    systemctl --user daemon-reload 2>/dev/null
    printf '  %sTimer removed.%s\n' "$C_GREEN" "$C_RESET"
}

# ------------------------------------------------------------------- cron ----
cron_status() {
    local line
    line=$(crontab -l 2>/dev/null | grep -F "$CRON_TAG")
    if [[ "$PORCELAIN" == true ]]; then
        printf 'cron\t%s\t\n' "$line"
        return 0
    fi
    if [[ -n "$line" ]]; then
        printf '  %sScheduled:%s %s\n' "$C_GREEN" "$C_RESET" "$line"
    else
        printf '  %sNo ghsync cron job installed.%s\n' "$C_DIM" "$C_RESET"
    fi
}

cron_install() {
    local sched="$1" tmp
    command -v crontab >/dev/null || { err "crontab not found — install cron (e.g. apt install cron)"; return 1; }
    tmp=$(mktemp)
    crontab -l 2>/dev/null | grep -vF "$CRON_TAG" >"$tmp"
    printf '%s %s sync --quiet >>%s 2>&1 %s\n' "$sched" "$SELF" "$LOG_FILE" "$CRON_TAG" >>"$tmp"
    if crontab "$tmp"; then
        rm -f "$tmp"
        printf '  %sInstalled:%s %s %s sync --quiet\n' "$C_GREEN" "$C_RESET" "$sched" "$SELF"
        printf '  %sLog: %s%s\n' "$C_DIM" "$LOG_FILE" "$C_RESET"
    else
        rm -f "$tmp"; err "failed to write crontab"; return 1
    fi
}

cron_remove() {
    local tmp
    command -v crontab >/dev/null || { err "crontab not found"; return 1; }
    tmp=$(mktemp)
    crontab -l 2>/dev/null | grep -vF "$CRON_TAG" >"$tmp"
    crontab "$tmp" && printf '  %sRemoved.%s\n' "$C_GREEN" "$C_RESET"
    rm -f "$tmp"
}

# -------------------------------------------------------------------- TUI ----
MENU_CHOICE=-1

banner() {
    clear
    printf '\n  %s%sghsync%s %s%s — GitHub repository sync%s\n' \
        "$C_BOLD" "$C_CYAN" "$C_RESET" "$C_DIM" "$VERSION" "$C_RESET"
    printf '  %s──────────────────────────────────────────────%s\n' "$C_DIM" "$C_RESET"
    printf '  %sroot%s %s   %sowner%s %s   %sproto%s %s   %sjobs%s %s\n\n' \
        "$C_DIM" "$C_RESET" "$ROOT" \
        "$C_DIM" "$C_RESET" "${OWNERS:-<you>}" \
        "$C_DIM" "$C_RESET" "$PROTOCOL" \
        "$C_DIM" "$C_RESET" "$JOBS"
}

menu() { # menu "Title" item...
    local title="$1"; shift
    local -a items=("$@")
    local sel=0 n=${#items[@]} key rest i
    tput civis 2>/dev/null
    trap 'tput cnorm 2>/dev/null; exit 130' INT
    while true; do
        banner
        printf '  %s%s%s\n\n' "$C_BOLD" "$title" "$C_RESET"
        for ((i = 0; i < n; i++)); do
            if ((i == sel)); then
                printf '  %s%s❯ %s%s\n' "$C_CYAN" "$C_BOLD" "${items[i]}" "$C_RESET"
            else
                printf '    %s\n' "${items[i]}"
            fi
        done
        printf '\n  %s↑/↓ or j/k · Enter to select · q to go back%s\n' "$C_DIM" "$C_RESET"
        IFS= read -rsn1 key
        case "$key" in
            $'\x1b') read -rsn2 -t 0.05 rest
                     case "$rest" in '[A') ((sel = (sel - 1 + n) % n));;
                                     '[B') ((sel = (sel + 1) % n));; esac ;;
            k|K)     ((sel = (sel - 1 + n) % n)) ;;
            j|J)     ((sel = (sel + 1) % n)) ;;
            q|Q)     MENU_CHOICE=-1; break ;;
            '')      MENU_CHOICE=$sel; break ;;
            [1-9])   (( key <= n )) && { MENU_CHOICE=$((key - 1)); break; } ;;
        esac
    done
    tput cnorm 2>/dev/null
    trap - INT
}

pause() { printf '\n  %sPress any key to continue…%s' "$C_DIM" "$C_RESET"; read -rsn1; printf '\n'; }

settings_menu() {
    local val
    while true; do
        menu "Settings — Enter to change, q to go back" \
            "Root directory      : $ROOT" \
            "Owners (blank = you): ${OWNERS:-<authenticated user>}" \
            "Clone protocol      : $PROTOCOL" \
            "Include forks       : $INCLUDE_FORKS" \
            "Include archived    : $INCLUDE_ARCHIVED" \
            "Parallel jobs       : $JOBS" \
            "Repo limit per owner: $LIMIT" \
            "GitHub host         : ${HOST:-github.com}" \
            "Clone filter        : $CLONE_FILTER" \
            "Bare mirrors        : $MIRROR" \
            "Exclude patterns    : ${EXCLUDE:-<none>}" \
            "Notify on failure   : $NOTIFY"
        case "$MENU_CHOICE" in
            0) read -rep "  New root directory: " -i "$ROOT" val && ROOT="${val/#\~/$HOME}" ;;
            1) read -rep "  Owners (space separated, blank for your own): " -i "$OWNERS" val && OWNERS="$val" ;;
            2) [[ "$PROTOCOL" == ssh ]] && PROTOCOL=https || PROTOCOL=ssh ;;
            3) [[ "$INCLUDE_FORKS" == true ]] && INCLUDE_FORKS=false || INCLUDE_FORKS=true ;;
            4) [[ "$INCLUDE_ARCHIVED" == true ]] && INCLUDE_ARCHIVED=false || INCLUDE_ARCHIVED=true ;;
            5) read -rep "  Parallel jobs: " -i "$JOBS" val && [[ "$val" =~ ^[0-9]+$ ]] && JOBS="$val" ;;
            6) read -rep "  Repo limit per owner: " -i "$LIMIT" val && [[ "$val" =~ ^[0-9]+$ ]] && LIMIT="$val" ;;
            7) read -rep "  GitHub host (blank for github.com): " -i "$HOST" val && HOST="$val" ;;
            8) read -rep "  Clone filter (blob:none, tree:0, depth:N, none): " -i "$CLONE_FILTER" val \
                   && CLONE_FILTER="$val" ;;
            9) [[ "$MIRROR" == true ]] && MIRROR=false || MIRROR=true ;;
            10) read -rep "  Exclude patterns: " -i "$EXCLUDE" val && EXCLUDE="$val" ;;
            11) [[ "$NOTIFY" == true ]] && NOTIFY=false || NOTIFY=true ;;
            *) save_config; return ;;
        esac
        save_config
    done
}

cron_menu() {
    while true; do
        menu "Scheduled updates" \
            "Every hour                (0 * * * *)" \
            "Every 6 hours             (0 */6 * * *)" \
            "Every day at 03:00        (0 3 * * *)" \
            "Every Monday at 09:00     (0 9 * * 1)" \
            "Custom schedule…" \
            "Show current cron entry" \
            "Remove the cron job" \
            "systemd timer: every 6 hours" \
            "systemd timer: every day at 03:00" \
            "systemd timer: status" \
            "systemd timer: remove"
        local sched=""
        [[ "$MENU_CHOICE" -ge 0 ]] && banner
        case "$MENU_CHOICE" in
            0) cron_install "0 * * * *" ;;
            1) cron_install "0 */6 * * *" ;;
            2) cron_install "0 3 * * *" ;;
            3) cron_install "0 9 * * 1" ;;
            4) read -rep "  Cron expression: " -i "0 */6 * * *" sched
               [[ -n "$sched" ]] && cron_install "$sched" ;;
            5) cron_status ;;
            6) cron_remove ;;
            7) timer_install "*-*-* 00/6:00:00" ;;
            8) timer_install "*-*-* 03:00:00" ;;
            9) timer_status ;;
            10) timer_remove ;;
            *) return ;;
        esac
        pause
    done
}

tui() {
    while true; do
        menu "What would you like to do?" \
            "Clone missing repositories" \
            "Pull updates into existing repositories" \
            "Full sync (clone missing + pull all)" \
            "Status overview" \
            "Repository statistics" \
            "Retry failed operations" \
            "Find orphaned clones" \
            "Scheduled updates" \
            "Settings" \
            "View log" \
            "Quit"
        case "$MENU_CHOICE" in
            0) banner; action_clone;  pause ;;
            1) banner; action_pull;   pause ;;
            2) banner; action_sync;   pause ;;
            3) banner; action_status; pause ;;
            4) banner; action_stats;   pause ;;
            5) banner; action_retry;   pause ;;
            6) banner; action_orphans; pause ;;
            7) cron_menu ;;
            8) settings_menu ;;
            9) if [[ -f "$LOG_FILE" ]]; then ${PAGER:-less} +G "$LOG_FILE"; else banner; info "  No log yet."; pause; fi ;;
            *) clear; return 0 ;;
        esac
    done
}

# ------------------------------------------------------------------- usage ---
usage() {
    cat <<EOF
ghsync $VERSION — clone and update all your managed repositories.

Usage:
  ghsync                          launch the interactive TUI
  ghsync clone                    clone every managed repo missing from \$ROOT
  ghsync pull                     fetch + fast-forward every local repo
  ghsync commit OWNER/REPO "msg"  stage all changes and create a local commit
  ghsync sync                     clone missing, then pull everything
  ghsync status                   per-repo branch / dirty / ahead-behind
  ghsync stats                    per-repo commits, branches, tags, size, last commit
  ghsync retry                    re-run only the operations that failed last time
  ghsync orphans                  local clones not in GitHub or the third-party registry
  ghsync cron install "0 */6 * * *"
  ghsync cron remove
  ghsync cron status
  ghsync timer install "*-*-* 00/6:00:00"    systemd user timer instead of cron
  ghsync timer remove | status
  ghsync config                   print the current configuration
  ghsync check                    machine-readable environment probe

Options:
  --root DIR      repo root (default: $ROOT)
  --owner NAME    owner/org to sync; repeatable, default is your own repos
  --jobs N        parallel git operations (default: $JOBS)
  --ssh|--https   clone protocol (default: $PROTOCOL)
  --forks         include forks
  --host NAME     GitHub Enterprise host (sets GH_HOST)
  --filter SPEC   partial clone: blob:none, tree:0, depth:N, or none
  --mirror        clone bare mirrors instead of working trees
  --exclude GLOB  skip repos matching a pattern; repeatable
  --no-notify     do not send failures to the journal
  --archived      include archived repos
  -q, --quiet     no stdout, log only (used by the cron job)
  --porcelain     tab-separated output: TAG<TAB>NAME<TAB>DETAIL
  -h, --help      this text

Config: $CONFIG_FILE
Log:    $LOG_FILE
EOF
}

# -------------------------------------------------------------------- main ---
# hidden worker entry point used by xargs
if [[ "${1:-}" == "_worker" ]]; then
    case "$2" in
        clone)  IFS=$'\t' read -r _n _u <<<"$3"; do_clone "$_n" "$_u" ;;
        pull)   do_pull  "$3" ;;
        status) do_status "$3" ;;
        stats)  do_stats  "$3" ;;
    esac
    exit $?
fi

declare -a POS=() OWNER_ARGS=()
while (($#)); do
    case "$1" in
        --root)     ROOT="${2/#\~/$HOME}"; shift 2 ;;
        --owner)    OWNER_ARGS+=("$2"); shift 2 ;;
        --jobs)     JOBS="$2"; shift 2 ;;
        --limit)    LIMIT="$2"; shift 2 ;;
        --ssh)      PROTOCOL=ssh; shift ;;
        --https)    PROTOCOL=https; shift ;;
        --forks)    INCLUDE_FORKS=true; shift ;;
        --archived) INCLUDE_ARCHIVED=true; shift ;;
        -q|--quiet) QUIET=true; shift ;;
        --porcelain) PORCELAIN=true; shift ;;
        --host)     HOST="$2"; export GH_HOST="$2"; shift 2 ;;
        --filter)   CLONE_FILTER="$2"; shift 2 ;;
        --no-filter) CLONE_FILTER="none"; shift ;;
        --mirror)   MIRROR=true; shift ;;
        --exclude)  EXCLUDE="${EXCLUDE:+$EXCLUDE }$2"; shift 2 ;;
        --no-notify) NOTIFY=false; shift ;;
        -h|--help)  usage; exit 0 ;;
        -*)         err "unknown option: $1"; usage; exit 1 ;;
        *)          POS+=("$1"); shift ;;
    esac
done
((${#OWNER_ARGS[@]})) && OWNERS="${OWNER_ARGS[*]}"

CMD="${POS[0]:-}"
SUB="${POS[1]:-}"
FILTER=""
case "$CMD" in pull|update|status|stats) FILTER="$SUB" ;; esac
SCHED="${POS[2]:-0 */6 * * *}"

case "$CMD" in
    ""|tui)       preflight || exit 1; tui ;;
    clone)        action_clone ;;
    pull|update)  action_pull ;;
    commit)       action_commit "$SUB" "${POS[2]:-}" ;;
    sync)         action_sync ;;
    status)       action_status ;;
    stats)        action_stats ;;
    retry)        action_retry ;;
    orphans)      action_orphans ;;
    timer)
        case "$SUB" in
            install) timer_install "${POS[2]:-*-*-* 00/6:00:00}" ;;
            remove|uninstall) timer_remove ;;
            *)       timer_status ;;
        esac ;;
    check)        action_check ;;
    config)       [[ -f "$CONFIG_FILE" ]] || save_config; cat "$CONFIG_FILE" ;;
    cron)
        case "$SUB" in
            install) cron_install "$SCHED" ;;
            remove|uninstall) cron_remove ;;
            *)       cron_status ;;
        esac ;;
    *) err "unknown command: $CMD"; usage; exit 1 ;;
esac
